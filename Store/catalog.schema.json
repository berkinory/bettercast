{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "title", "description", "version", "packageURL", "bundleHash", "capabilityHash",
          "bundleBytes", "minimumAppVersion", "capabilities", "verified"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "packageURL": { "type": "string", "format": "uri", "pattern": "^https://" },
          "bundleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "capabilityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bundleBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
          "minimumAppVersion": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "sourceRepository": { "type": ["string", "null"], "format": "uri" },
          "license": { "type": ["string", "null"] },
          "verified": { "type": "boolean", "const": true }
        }
      }
    }
  }
}
