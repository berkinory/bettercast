{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencast.app/schemas/extension-capabilities.schema.json",
  "title": "Opencast Extension Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "risk", "consent", "description"],
        "properties": {
          "name": {
            "$ref": "#/$defs/capabilityName"
          },
          "risk": {
            "type": "string",
            "enum": ["none", "local", "sensitive", "network"]
          },
          "consent": {
            "type": "string",
            "enum": ["install", "each-use", "settings", "none"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  },
  "$defs": {
    "capabilityName": {
      "type": "string",
      "enum": [
        "clipboard.read",
        "clipboard.write",
        "clipboard.paste",
        "selectedText.read",
        "open.url",
        "open.application",
        "finder.reveal",
        "finder.selection.read",
        "filesystem.read",
        "filesystem.write",
        "filesystem.list",
        "filesystem.pick",
        "filesystem.quickLook",
        "storage.read",
        "storage.write",
        "storage.delete",
        "storage.sqlite",
        "preferences.read",
        "process.execute",
        "process.inspect",
        "process.terminate",
        "process.restart",
        "process.cancel",
        "ports.inspect",
        "system.metrics.read",
        "network.request",
        "application.list",
        "application.frontmost",
        "applescript.execute",
        "browser.read",
        "browser.mutate",
        "menuBar.publishSnapshot"
      ]
    }
  }
}
