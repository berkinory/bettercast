{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencast.app/schemas/extension-manifest.schema.json",
  "title": "Opencast Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "title", "description", "commands"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "license": {
      "type": "string",
      "maxLength": 80
    },
    "preferences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/preference" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "entry", "mode"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "maxLength": 80
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "entry": {
          "type": "string",
          "pattern": "^[^/].*\\.(?:js|mjs)$"
        },
        "mode": {
          "type": "string",
          "enum": ["view", "no-view"]
        },
        "interval": {
          "type": "string",
          "pattern": "^(?:[1-9]\\d*) (?:second|seconds|minute|minutes|hour|hours|day|days)$"
        },
        "menuBar": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://opencast.app/schemas/extension-capabilities.schema.json#/$defs/capabilityName"
          }
        },
        "networkDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          }
        },
        "preferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/preference" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "menuBar": {
                "const": true
              }
            },
            "required": ["menuBar"]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "view"
              }
            }
          }
        }
      ]
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "type": {
          "type": "string",
          "enum": ["textfield", "password", "checkbox", "dropdown", "date"]
        },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "boolean", "number"] },
        "data": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "value"],
                "properties": {
                  "title": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
