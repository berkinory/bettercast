{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencast.app/schemas/extension-render-protocol.schema.json",
  "title": "Opencast Extension Render Protocol",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/launch"
    },
    {
      "$ref": "#/$defs/render"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/capabilityRequest"
    },
    {
      "$ref": "#/$defs/capabilityResponse"
    },
    {
      "$ref": "#/$defs/log"
    },
    {
      "$ref": "#/$defs/dispose"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/feedback"
    },
    {
      "$ref": "#/$defs/capabilityProgress"
    },
    {
      "$ref": "#/$defs/navigation"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$",
      "maxLength": 160
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requestID",
        "bundlePath",
        "mode"
      ],
      "properties": {
        "type": {
          "const": "launch"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "bundlePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "enum": [
            "view",
            "no-view",
            "menu-bar"
          ]
        },
        "entry": {
          "type": "string",
          "maxLength": 512
        },
        "background": {
          "type": "boolean"
        },
        "commandName": {
          "$ref": "#/$defs/id"
        },
        "extensionName": {
          "$ref": "#/$defs/id"
        },
        "launchType": {
          "type": "string",
          "enum": ["userInitiated", "background"]
        },
        "supportPath": {
          "type": "string",
          "maxLength": 4096
        },
        "assetsPath": {
          "type": "string",
          "maxLength": 4096
        },
        "preferences": {
          "type": "object"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requestID",
        "root",
        "items",
        "actions"
      ],
      "properties": {
        "type": {
          "const": "render"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "root": {
          "type": "string",
          "enum": [
            "list",
            "grid",
            "detail",
            "form",
            "menuBarSnapshot"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "detail": {
          "$ref": "#/$defs/detail"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "selectedItemID": {
          "$ref": "#/$defs/id"
        },
        "loading": {
          "type": "boolean"
        },
        "emptyView": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "icon": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasMore"
          ],
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "cursor": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "searchBarPlaceholder": {
          "type": "string",
          "maxLength": 160
        },
        "filtering": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "listDropdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "tooltip", "value", "options"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "tooltip": { "type": "string", "maxLength": 160 },
            "value": { "type": "string", "maxLength": 160 },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "value"],
                "properties": {
                  "title": { "type": "string", "maxLength": 160 },
                  "value": { "type": "string", "maxLength": 160 }
                }
              }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 240
        },
        "subtitle": {
          "type": "string",
          "maxLength": 240
        },
        "icon": {
          "type": "string",
          "maxLength": 512
        },
        "accessories": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "maxLength": 240 },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "icon": { "type": "string", "maxLength": 160 },
                  "text": { "type": "string", "maxLength": 240 }
                }
              }
            ]
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown"
      ],
      "properties": {
        "markdown": {
          "type": "string",
          "maxLength": 500000
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 120
              },
              "value": {
                "type": "string",
                "maxLength": 500
              }
            },
            "sections": {
              "type": "array",
              "items": { "type": "object" }
            },
            "links": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "password",
            "textarea",
            "checkbox",
            "dropdown",
            "date",
            "file",
            "directory"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "value": {},
        "placeholder": { "type": "string", "maxLength": 240 },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "object" } },
        "error": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "shortcut": {
          "type": "string",
          "maxLength": 40
        },
        "section": {
          "type": "string",
          "maxLength": 120
        },
        "destructive": {
          "type": "boolean"
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event",
        "requestID"
      ],
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "type": "string",
          "enum": [
            "selectionChanged",
            "searchChanged",
            "actionInvoked",
            "formChanged",
            "loadMore",
            "dropdownChanged",
        "formSubmitted",
            "confirmResponse",
            "cancel"
          ]
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "itemID": {
          "$ref": "#/$defs/id"
        },
        "actionID": {
          "$ref": "#/$defs/id"
        },
        "fieldID": {
          "$ref": "#/$defs/id"
        },
        "value": {},
        "confirmed": { "type": "boolean" },
        "fields": {
          "type": "object"
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requestID",
        "capability",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "capabilityRequest"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "capability": {
          "$ref": "https://opencast.app/schemas/extension-capabilities.schema.json#/$defs/capabilityName"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "capabilityResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requestID",
        "ok"
      ],
      "properties": {
        "type": {
          "const": "capabilityResponse"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "type": "boolean"
        },
        "value": {},
        "error": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "message"
      ],
      "properties": {
        "type": {
          "const": "log"
        },
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "capabilityProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestID", "done"],
      "properties": {
        "type": { "const": "capabilityProgress" },
        "requestID": { "$ref": "#/$defs/id" },
        "capability": { "type": "string" },
        "jobID": { "$ref": "#/$defs/id" },
        "stream": { "type": "string" },
        "chunk": { "type": "string", "maxLength": 65536 },
        "done": { "type": "boolean" },
        "status": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "timedOut": { "type": "boolean" },
        "cancelled": { "type": "boolean" }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "feedback"],
      "properties": {
        "type": { "const": "feedback" },
        "feedback": { "type": "string" },
        "toastID": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 240 },
        "message": { "type": "string", "maxLength": 1000 },
        "style": { "type": "string" },
        "requestID": { "$ref": "#/$defs/id" },
        "primaryAction": { "type": "string", "maxLength": 160 },
        "dismissAction": { "type": "string", "maxLength": 160 }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action"],
      "properties": {
        "type": { "const": "navigation" },
        "action": { "type": "string", "enum": ["push", "pop", "popToRoot"] },
        "component": {}
      }
    },
    "dispose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "dispose"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "enum": [
            "completed",
            "cancelled",
            "closed",
            "snapshot",
            "timeout",
            "memory"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationMS": {
              "type": "integer",
              "minimum": 0
            },
            "peakResidentBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalidMessage",
            "unsupportedAPI",
            "capabilityDenied",
            "timeout",
            "runtime"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
