{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencast.app/schemas/opencast-extension.schema.json",
  "title": "Opencast Extension Build Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commands"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "src", "mode", "capabilities"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "src": { "type": "string", "pattern": "^[^/].*\\.(?:js|jsx|ts|tsx)$" },
          "mode": { "type": "string", "enum": ["view", "no-view", "menu-bar"] },
          "interval": { "type": "string", "maxLength": 32 },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["names"],
            "properties": {
              "names": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "networkDomains": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "executables": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "filesystemRoots": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^(?:extension|home)(?:/.*)?$" }
              },
              "shell": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
